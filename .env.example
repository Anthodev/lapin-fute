# Lapin Futé operator environment (phone-only architecture: no backend server,
# no server deployment variables). Copy to .env for local operations:
#   node --env-file=.env npm run catalog:refresh
# Secrets live only in .env (gitignored); scripts never print or export them.

# Required by scripts/refresh-catalog.mjs: IDFM dataset token used to download
# and re-verify the GTFS/catalog source datasets.
IDFM_DATASET_TOKEN=

# Required by scripts/probe-catalog.mjs: personal PRIM key for the one-call
# live stop-monitoring probe (one request per transport mode at most).
PRIM_API_KEY=

# Optional paths (defaults shown):
# CATALOG_PATH=var/catalog/catalog.sqlite
# CATALOG_STATIC_PATH=var/catalog/static

# Optional, scripts/build.mjs: absolute HTTPS URL of the statically hosted
# configuration site, baked into the phone companion bootstrap.
# LAPIN_FUTE_CONFIG_URL=
