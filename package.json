{
  "name": "lapin-fute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "catalog:probe": "node scripts/probe-catalog.mjs",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "badges:sync": "node scripts/sync-line-badges.mjs",
    "measure:radio": "node scripts/measure-radio.mjs",
    "measure:catalog": "node scripts/measure-catalog.mjs",
    "measure:config-page": "node scripts/measure-config-page.mjs",
    "test": "node scripts/test.mjs",
    "test:contracts": "node --test packages/contracts/test/contracts.test.ts",
    "test:watch": "node --test packages/watch/test/*.test.js",
    "verify:watch-build": "node scripts/verify-watch-build.mjs"
  }
}
